{
  // Renovate proposes, the architect triages (docs/decisions.md, D23).
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard",
    "helpers:pinGitHubActionDigests",
    // Talos versions from factory.talos.dev, in YAML files under talos/
    // (installer image tag or a talosVersion key).
    "github>home-operations/renovate-presets//apps/talosFactory.json5",
  ],
  timezone: "Europe/Istanbul",
  // Before 06:00 on Monday. Cron form; the text form is deprecated.
  schedule: ["* 0-5 * * 1"],
  minimumReleaseAge: "3 days",
  labels: ["dependencies"],
  prConcurrentLimit: 5,
  commitBodyTable: true,
  // Flux objects under kubernetes/: OCIRepository tags of the charts.
  flux: {
    managerFilePatterns: ["/^kubernetes/.+\\.ya?ml$/"],
  },
  customManagers: [
    {
      description: "Kubernetes version of the cluster in mise.toml (D29)",
      customType: "regex",
      managerFilePatterns: ["/^mise\\.toml$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[A-Z_]+ = \"(?<currentValue>[^\"]+)\"",
      ],
      extractVersionTemplate: "^v?(?<version>.*)$",
    },
    {
      description: "Values under kubernetes/ marked with a renovate comment (the Flux version in the FluxInstance)",
      customType: "regex",
      managerFilePatterns: ["/^kubernetes/.+\\.ya?ml$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*[A-Za-z]+: \"?(?<currentValue>[^\"\\s]+)\"?",
      ],
      extractVersionTemplate: "^v?(?<version>.*)$",
    },
  ],
  packageRules: [
    {
      description: "GitHub Actions, pinned by digest",
      matchManagers: ["github-actions"],
      groupName: "ci",
    },
    {
      description: "Tools pinned in mise.toml",
      matchManagers: ["mise"],
      groupName: "dev tools",
    },
    {
      description: "Clients of the cluster's components move with an upgrade drill (D23), not with the dev tools group",
      matchManagers: ["mise"],
      matchDepNames: ["talosctl", "kubectl", "flux2", "cilium-cli"],
      matchUpdateTypes: ["minor", "major"],
      groupName: null,
      labels: ["dependencies", "upgrade-drill"],
    },
    {
      description: "Components of the cluster move with an upgrade drill (D23)",
      matchPackageNames: ["/siderolabs/", "/talos/", "/cilium/", "/flux/"],
      matchUpdateTypes: ["minor", "major"],
      labels: ["dependencies", "upgrade-drill"],
    },
    {
      description: "Kubernetes stays on 1.36 until a Cilium release lists 1.37 (D29)",
      matchPackageNames: ["ghcr.io/siderolabs/kubelet"],
      allowedVersions: "<1.37",
    },
    {
      description: "The runner image is pinned on purpose; it moves deliberately, not by Renovate",
      matchDatasources: ["github-runners"],
      enabled: false,
    },
    {
      description: "OpenTofu providers and modules come from the OpenTofu registry",
      matchDatasources: ["terraform-provider", "terraform-module"],
      registryUrls: ["https://registry.opentofu.org"],
    },
  ],
}
